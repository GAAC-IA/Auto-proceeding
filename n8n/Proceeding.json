      "parameters": {
        "jsCode": "const body = $node['Validate Input'].json.body;\nconst actionItems = body.action_items || [];\n\nif (actionItems.length === 0) {\n  return [{ json: { skip: true, message: '액션 아이템 없음', meetingTitle: body.title } }];\n}\n\nreturn actionItems.map((item) => ({\n  json: {\n    skip: false,\n    task: item.task || '작업명 없음',\n    assignee: item.assignee || '미정',\n    due_date: item.due_date || null,\n    meetingTitle: body.title || '회의 제목 없음',\n    summary: body.summary || ''\n  }\n}));"
